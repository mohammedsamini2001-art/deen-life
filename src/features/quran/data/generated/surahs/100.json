{"index":100,"nameArabic":"العاديات","ayahs":[{"index":1,"text":"وَٱلْعَٰدِيَٰتِ ضَبْحًا"},{"index":2,"text":"فَٱلْمُورِيَٰتِ قَدْحًا"},{"index":3,"text":"فَٱلْمُغِيرَٰتِ صُبْحًا"},{"index":4,"text":"فَأَثَرْنَ بِهِۦ نَقْعًا"},{"index":5,"text":"فَوَسَطْنَ بِهِۦ جَمْعًا"},{"index":6,"text":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌ"},{"index":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ"},{"index":8,"text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ"},{"index":9,"text":"أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ"},{"index":10,"text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ"},{"index":11,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ"}]}