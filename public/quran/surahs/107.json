{"index":107,"nameArabic":"الماعون","ayahs":[{"index":1,"text":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","translation":"Hast thou observed him who belieth religion"},{"index":2,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","translation":"That is he who repelleth the orphan"},{"index":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","translation":"And urgeth not the feeding of the needy"},{"index":4,"text":"فَوَيْلٌ لِّلْمُصَلِّينَ","translation":"Ah, woe unto worshippers"},{"index":5,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","translation":"Who are heedless of their prayer"},{"index":6,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ","translation":"Who would be seen (at worship)"},{"index":7,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ","translation":"Yet refuse small kindnesses"}]}