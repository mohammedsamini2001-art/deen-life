{"index":106,"nameArabic":"قريش","ayahs":[{"index":1,"text":"لِإِيلَٰفِ قُرَيْشٍ","bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"},{"index":2,"text":"إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ"},{"index":3,"text":"فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ"},{"index":4,"text":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ"}]}